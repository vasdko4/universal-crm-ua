# ── Universal Magazine — переменные окружения ──────────────────────────────
# Скопируйте этот файл в .env.local и при необходимости отредактируйте:
#   cp .env.example .env.local

# Подключение к локальной базе Postgres.
# Можно оставить пустым — тогда при первом запуске откроется мастер, где данные
# подключения (хост, порт, база, пользователь, пароль) вводятся вручную и
# сохраняются сюда автоматически.
#
# Пример для docker-compose.yml из этого репозитория:
#   DATABASE_URL="postgres://techno:<POSTGRES_PASSWORD from .env>@localhost:5433/techno_store"
# Пример для OSPanel (модуль PostgreSQL, по умолчанию порт 5432):
#   DATABASE_URL="postgres://postgres:пароль@localhost:5432/techno_store"
DATABASE_URL=""

# Секрет для Better Auth (обязателен). Сгенерируйте свой:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Базовый URL приложения для Better Auth (для локали оставьте как есть).
# За TLS-прокси (nginx/Caddy) ставьте https://ваш-домен — от этого зависят
# Secure-куки сессии. http://localhost только для разработки без HTTPS.
BETTER_AUTH_URL="http://localhost:3000"

# CIDR доверенных прокси через запятую (по умолчанию только loopback).
# За nginx/Caddy в Docker добавьте сеть прокси, иначе все клиенты попадут
# в один per-IP бакет Better Auth.
# TRUSTED_PROXIES="127.0.0.1/32,10.0.0.0/8"

# API-ключ Нова Пошти (необязательно).
# Если не указать здесь, используется ключ из настроек доставки в базе (seed).
# NOVA_POSHTA_API_KEY=""

# Секрет для защиты /api/cron/delivery-sync (обязателен для продакшена!).
# Эндпоинт работает fail closed: без секрета он отвечает 503 и НЕ выполняет
# синхронизацию, с неверным заголовком — 401. Значение-плейсхолдер ниже
# считается незаданным секретом, поэтому его обязательно нужно заменить:
# иначе cron доставок просто не будет работать.
# Сгенерируйте свой: openssl rand -base64 32
# На Vercel также впишите то же значение в Project Settings → Environment
# Variables — тогда Vercel Cron сам подставит его в заголовок Authorization.
CRON_SECRET="replace-me-with-openssl-rand-base64-32"

# One-time token for /setup, saveDatabaseConfig and runSetup. Without it a
# fresh install (no users yet) is open to anyone who can reach the URL.
# Generated automatically on first boot (printed once in the server log and
# saved to .setup-token). Set it here to pin a known value:
#   openssl rand -base64 32
# SETUP_TOKEN=""

# Секрет для сайдкара автообновления (обязателен, чтобы кнопка «Обновить» на
# странице /admin/updates работала; без него страница просто показывает
# текущую/последнюю версию без возможности обновить одним кликом).
# Сгенерируйте свой: openssl rand -base64 32
# UPDATER_SECRET=""

# ── Server-side GA4 (Measurement Protocol, дубль события purchase) ──────
# После подтверждённой оплаты сервер досылает purchase в GA4 — браузерный
# пиксель у части посетителей блокируется адблокерами, и выручка в GA4
# занижается. Без этих двух переменных отправка тихо отключена (no-op),
# ошибки отправки только логируются и никогда не ломают оплату.
# Measurement ID: GA4 → Admin → Data Streams → Measurement ID (G-XXXXXXXXXX).
# API secret: GA4 → Admin → Data Streams → Measurement Protocol API secrets.
# GA4_MEASUREMENT_ID=<redacted>
# GA4_API_SECRET=<redacted>

# ── Алерты аномалий (cron /api/cron/anomaly-alert, каждые 2 часа днём) ───
# Крон проверяет два условия и шлёт Telegram админу (тот же бот/чат, что и
# алерты заказов из Настройки → Уведомления):
#   1) 0 заказов за последние N часов в дневное время (Europe/Kyiv);
#   2) всплеск отмен/возвратов за 24 часа относительно базовой линии 7 дней.
# Пороги ниже — необязательны, показаны значения по умолчанию.
# ANOMALY_ZERO_ORDER_HOURS="6"
# ANOMALY_DAY_START="8"
# ANOMALY_DAY_END="23"
# ANOMALY_CANCEL_SPIKE_MULTIPLIER="2"
# ANOMALY_CANCEL_SPIKE_MIN="5"

# ── Пул соединений с БД (необязательно) ──────────────────────────────
# Настройки под высокую нагрузку. Значения по умолчанию подходят большинству
# случаев; увеличьте DB_POOL_MAX, если ждёте много одновременных посетителей и
# ваш Postgres/пулер позволяет больше соединений.
# DB_POOL_MAX="20"           # макс. соединений в пуле этого инстанса
# DB_POOL_IDLE_MS="30000"    # через сколько мс закрывать простаивающее соединение
# DB_POOL_CONNECT_MS="10000" # сколько мс ждать свободное соединение под нагрузкой
# DB_POOL_MAX_USES="7500"    # пересоздавать соединение после N запросов

# Фото товаров в админке по умолчанию сохраняются локально (public/uploads) —
# ничего указывать не нужно для Docker. Задайте эту переменную только если
# деплоите на Vercel и хотите хранить фото в Vercel Blob вместо диска:
# BLOB_READ_WRITE_TOKEN=""

# ── Google Ads: server-side дублирование конверсий (необязательно) ─────────
# После успешной оплаты заказ дублируется в Google Ads через API
# (ConversionUploadService.UploadClickConversions, lib/ads/offline-conversions.ts)
# — заказы засчитываются, даже если клиентский gtag-пиксель не сработал
# (блокировщики рекламы, ITP, закрытая вкладка). Без этих переменных
# загрузка молча пропускается (no-op), клиентский трекинг работает как раньше.
#
# Как получить:
# 1. Developer token: Google Ads → Инструменты → API-центр (нужен доступ MCC/менеджера).
# 2. OAuth client id/secret: Google Cloud Console → APIs & Services → Credentials →
#    Create Credentials → OAuth client ID (тип Web application). При создании
#    refresh-токена запросите scope https://www.googleapis.com/auth/adwords
#    (проще всего через OAuth2 Playground: https://developers.google.com/oauthplayground).
# 3. Customer ID: 10 цифр из интерфейса Google Ads (дефисы можно оставить — уберутся сами).
# 4. Conversion action ID: Цели → Сводка → нужное действие-конверсия (тип «Загрузки кликов»,
#    для него же включите «Расширенные конверсии для лидов» — без gclid сопоставление
#    идёт по хешированным email/телефону покупателя).
#
# На Vercel впишите те же значения в Project Settings → Environment Variables.
# GOOGLE_ADS_DEVELOPER_TOKEN=""
# GOOGLE_ADS_CLIENT_ID=""
# GOOGLE_ADS_CLIENT_SECRET=""
# GOOGLE_ADS_REFRESH_TOKEN=""
# GOOGLE_ADS_CUSTOMER_ID=""
# GOOGLE_ADS_CONVERSION_ACTION_ID=""

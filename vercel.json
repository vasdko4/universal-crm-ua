{
  "crons": [
    {
      "path": "/api/cron/delivery-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/analytics-retention",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/expire-pending",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
